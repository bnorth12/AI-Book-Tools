{
  "name": "ai-book-tools",
  "version": "1.3.0",
  "description": "Static HTML/JavaScript tools for AI-assisted writing and book editing",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "serve": "python -m http.server 8000",
    "lint": "htmlhint \"**/*.html\"",
    "lint:md": "markdownlint -c .markdownlint.jsonc -p .markdownlintignore \"**/*.md\"",
    "lint:js": "echo 'JavaScript linting not configured yet'",
    "test": "npm run lint && npm run validate-json",
    "test:ci:xai-guard": "node scripts/_ci_guard_xai_dispatch_only.mjs",
    "test:governance": "node scripts/governance/check-requirements-governance.js",
    "test:e2e": "playwright test",
    "test:e2e:novelwriter": "playwright test tests/e2e/novelwriter.regression.spec.js",
    "test:smoke:nw-draft-only": "node scripts/_smoke_nw_draft_only.mjs",
    "test:smoke:nw-qcat-harness": "node scripts/_smoke_qcat_harness.mjs",
    "test:smoke:nw-callai-timeout": "node scripts/_smoke_nw_callai_timeout.mjs",
    "test:smoke:nw-integrate": "node scripts/_smoke_nw_integrate.mjs",
    "test:smoke:nw-retention": "node scripts/_smoke_nw_retention.mjs",
    "test:smoke:qe5": "node scripts/_qe5_smoke.cjs",
    "test:smoke:b2-lean": "node scripts/_smoke_b2_lean.mjs",
    "test:ci:smoke-guards": "node scripts/_ci_guard_163_smokes.mjs",
    "test:ci:nw-smokes-wired": "node scripts/_ci_guard_nw_smokes_wired.mjs",
    "test:smoke:nw-mock-ai": "node scripts/_smoke_nw_mock_ai.mjs",
    "test:smoke:nw-migration": "node scripts/_smoke_nw_migration.mjs",
    "test:smoke:nw-setup-lock": "node scripts/_smoke_nw_setup_lock.mjs",
    "test:smoke:nw-s1-pin": "node scripts/_smoke_nw_s1_pin.mjs",
    "test:contract:story-core": "node scripts/_smoke_story_core_contract.mjs",
    "test:smoke:nw-trust-q1q3": "node scripts/_smoke_nw_trust_q1q3.mjs",
    "test:smoke:nw-writing-plans": "node scripts/_smoke_nw_writing_plans.mjs",
    "test:smoke:nw-story-core-21": "node scripts/_smoke_nw_story_core_21.mjs",
    "smoke:nw-167": "node scripts/_smoke_nw_167_gates.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:regression": "npm run test:governance && npm run test:e2e",
    "validate-json": "for file in $(find . -name \"*.json\" -not -path \"./node_modules/*\"); do jq empty \"$file\" || exit 1; done && echo 'All JSON valid'",
    "build": "echo 'No build step required - static files only'",
    "preview": "echo 'Open index.html in browser to preview'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnorth12/AI-Book-Tools.git"
  },
  "keywords": [
    "writing",
    "ai",
    "novel",
    "book",
    "editor",
    "author",
    "creative-writing"
  ],
  "author": "bnorth12",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bnorth12/AI-Book-Tools/issues"
  },
  "homepage": "https://github.com/bnorth12/AI-Book-Tools#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ajv": "^8.20.0",
    "htmlhint": "^1.1.4",
    "js-yaml": "^5.4.2",
    "markdownlint-cli": "^0.49.1"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead"
  ],
  "overrides": {
    "js-yaml": "^5.4.2",
    "smol-toml": "^1.9.1",
    "katex": "^0.18.2"
  },
  "dependencies": {
    "dotenv": "^18.0.6"
  }
}
