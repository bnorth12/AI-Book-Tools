    "chapterPlan": {
      "description": "One outline per chapter (NovelWriter scaffold PLAN-v1.2 section 9(a)). Optional; tools that do not plan scenes ignore it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "scenes"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "spineRef": {
          "type": "string",
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "parts": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "enum": [
                  "p1",
                  "p2",
                  "p3",
                  "p4"
                ]
              },
              "wordBudget": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/sceneCard"
          }
        }
      }
    },
    "sceneCard": {
      "description": "One planned scene. Required: part, order, beat. Characters are referenced by id, not by name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "order",
        "beat"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 40
        },
        "part": {
          "description": "Chapter part this scene belongs to, p1-p4 (matches parts maxItems 4).",
          "enum": [
            "p1",
            "p2",
            "p3",
            "p4"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "beat": {
          "description": "What happens in the scene, in prose, 20-400 characters. Must not contain double quotes: straight (\") and curly (\u201C \u201D) double quotes are rejected so beats stay prose, not dialogue. This also blocks quoted titles; write titles without double quotes.",
          "type": "string",
          "minLength": 20,
          "maxLength": 400,
          "pattern": "^[^\"\u201C\u201D]*$"
        },
        "plotPoint": {
          "type": "string",
          "maxLength": 240
        },
        "subplotBeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subplotIdx",
            "part"
          ],
          "properties": {
            "subplotIdx": {
              "type": "integer",
              "minimum": 0
            },
            "part": {
              "enum": [
                "want",
                "obstacle",
                "flaw",
                "stakes"
              ]
            },
            "mode": {
              "enum": [
                "echoes",
                "complicates"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 240
            }
          }
        },
        "charArcStep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "charId",
            "step"
          ],
          "properties": {
            "charId": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "maxLength": 240
            },
            "setback": {
              "type": "boolean"
            }
          }
        },
        "storyArcStep": {
          "type": "string",
          "maxLength": 240
        },
        "goal": {
          "type": "string",
          "maxLength": 240
        },
        "conflict": {
          "type": "string",
          "maxLength": 240
        },
        "outcome": {
          "description": "Scene outcome: yes (resolution), no, yes-but, no-and.",
          "enum": [
            "yes",
            "no",
            "yes-but",
            "no-and"
          ]
        },
        "sequel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reaction": {
              "type": "string"
            },
            "dilemma": {
              "type": "string"
            },
            "decision": {
              "type": "string"
            }
          }
        },
        "pov": {
          "type": "string"
        },
        "cast": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "beatsCovered": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "wordBudget": {
          "type": "integer",
          "minimum": 0
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "storyOutline",
                  "characterSheet",
                  "reference",
                  "research",
                  "userNote"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 120
              },
              "anchor": {
                "type": "string",
                "maxLength": 300
              },
              "quoteHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{12}$"
              }
            }
          }
        }
      }
    }
  }
}
