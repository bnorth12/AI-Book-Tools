                  {
                    "not": {
                      "type": "string",
                      "pattern": "://(?=[^/@])[\\r\\n\\u2028\\u2029]*[^/@\\r\\n\\u2028\\u2029][^/@\\r\\n\\u2028\\u2029:]*[\\r\\n\\u2028\\u2029]*:[\\r\\n\\u2028\\u2029]*(?:[^/@\\r\\n\\u2028\\u2029]+[\\r\\n\\u2028\\u2029]*)?@"
                    }
                  },
                  {
