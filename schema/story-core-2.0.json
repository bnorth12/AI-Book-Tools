{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/story-core-2.0.json",
  "title": "AI Book Tools Story Core 2.0",
  "description": "Additive shared book/story contract. Unknown fields are preserved, but secret-bearing keys and credential-bearing URL values are forbidden.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "coreVersion": {
      "type": "string"
    },
    "sourceTool": {
      "type": "string"
    },
    "sourceVersion": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string"
    },
    "workType": {
      "enum": ["fiction", "nonfiction"]
    },
    "novelData": {
      "type": "object",
      "properties": {
        "story": {
          "$ref": "#/$defs/story"
        }
      },
      "additionalProperties": true
    },
    "ext": {
      "type": "object",
      "properties": {
        "novelWriter": {
          "type": "object",
          "additionalProperties": true
        },
        "bookEditor": {
          "type": "object",
          "additionalProperties": true
        },
        "bookDecomposer": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "providerConfig": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "coreVersion",
    "sourceTool",
    "sourceVersion",
    "exportedAt",
    "workType",
    "novelData"
  ],
  "allOf": [
    {
      "$ref": "#/$defs/noSecrets"
    },
    {
      "if": {
        "properties": {
          "workType": {
            "const": "fiction"
          }
        },
        "required": ["workType"]
      },
      "then": {
        "properties": {
          "novelData": {
            "type": "object",
            "properties": {
              "story": {
                "$ref": "#/$defs/story"
              }
            },
            "required": ["story"]
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "story": {
      "type": "object",
      "properties": {
        "book": {
          "$ref": "#/$defs/book"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      },
      "required": ["book"],
      "additionalProperties": true
    },
    "book": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "synopsis": {
          "type": ["string", "null"]
        },
        "seriesId": {
          "type": ["string", "null"]
        },
        "bookNumber": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "required": ["id", "title"],
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "additionalProperties": true
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ch_"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["id"],
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sc_"
        },
        "chapterId": {
          "type": "string",
          "pattern": "^ch_"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "breakApproved": {
          "type": "boolean"
        }
      },
      "required": ["id", "chapterId", "order", "breakApproved"],
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "enum": ["ai", "user", "import"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approved": {
          "type": "boolean"
        },
        "approvedAt": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "span": {
          "type": "object",
          "properties": {
            "chapter": {
              "type": "string"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["chapter", "start", "end"],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "noSecrets": {
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "patternProperties": {
              "^(?:[\\s\\S]*[tT][-_\\r\\n\\u2028\\u2029]*[oO][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[nN][-_\\r\\n\\u2028\\u2029]*|[\\s\\S]*[aA][-_\\r\\n\\u2028\\u2029]*[pP][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][\\s\\S]*|[-_\\r\\n\\u2028\\u2029]*[oO][-_\\r\\n\\u2028\\u2029]*[pP][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[nN][-_\\r\\n\\u2028\\u2029]*[aA][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][-_\\r\\n\\u2028\\u2029]*|[-_\\r\\n\\u2028\\u2029]*[xX][-_\\r\\n\\u2028\\u2029]*[aA][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][-_\\r\\n\\u2028\\u2029]*|[-_\\r\\n\\u2028\\u2029]*[aA][-_\\r\\n\\u2028\\u2029]*[nN][-_\\r\\n\\u2028\\u2029]*[tT][-_\\r\\n\\u2028\\u2029]*[hH][-_\\r\\n\\u2028\\u2029]*[rR][-_\\r\\n\\u2028\\u2029]*[oO][-_\\r\\n\\u2028\\u2029]*[pP][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[cC][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][-_\\r\\n\\u2028\\u2029]*|[-_\\r\\n\\u2028\\u2029]*[gG][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[mM][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[nN][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][-_\\r\\n\\u2028\\u2029]*|[-_\\r\\n\\u2028\\u2029]*[gG][-_\\r\\n\\u2028\\u2029]*[iI][-_\\r\\n\\u2028\\u2029]*[tT][-_\\r\\n\\u2028\\u2029]*[hH][-_\\r\\n\\u2028\\u2029]*[uU][-_\\r\\n\\u2028\\u2029]*[bB][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[yY][-_\\r\\n\\u2028\\u2029]*|[-_\\r\\n\\u2028\\u2029]*[gG][-_\\r\\n\\u2028\\u2029]*[oO][-_\\r\\n\\u2028\\u2029]*[oO][-_\\r\\n\\u2028\\u2029]*[gG][-_\\r\\n\\u2028\\u2029]*[lL][-_\\r\\n\\u2028\\u2029]*[eE][-_\\r\\n\\u2028\\u2029]*[kK][-_\\r\\n\\u2028\\u2